DJANGO_SECRET_KEY=development-only-replace-before-deployment
DJANGO_SETTINGS_MODULE=config.settings.development
DATABASE_URL=postgresql://gateway:local-development-only@db:5432/gateway
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://redis:6379/0
# Generate: docker compose run --rm web python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CONVAY_BASE_URL=https://convay.com
CONVAY_TRUSTED_HOST_SUFFIXES=convay.com
CONVAY_CONNECT_TIMEOUT=5
CONVAY_READ_TIMEOUT=30
DEFAULT_PROVIDER_MEETING_TYPE=instant
ROOM_BUFFER_BEFORE_MINUTES=0
ROOM_BUFFER_AFTER_MINUTES=0

# Enable only behind a proxy that strips/replaces forwarded headers.
TRUST_PROXY_HTTPS=false
SECURE_HSTS_SECONDS=31536000
# Optional JSON mapping of old version labels to retained encryption keys.
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={}

GATEWAY_ACCESS_TOKEN_TTL_SECONDS=3600
# Optional separate strong signing key; defaults to DJANGO_SECRET_KEY.
GATEWAY_JWT_SIGNING_KEY=
